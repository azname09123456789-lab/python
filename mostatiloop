import turtle
class kian:
    def __init__(self, tol, arz):
        self.tol = tol
        self.arz = arz
        self.t = turtle.Turtle()
        
    def get_masahat(self):
        
        return self.tol * self.arz

    def get_mohit(self):
        
        return  (self.tol + self.arz)*2

    def draw_rectangle(self):
        
        print(f"رسم مستطیل: مساحت {self.get_masahat()} و محیط {self.get_mohit()}")
        for _ in range(2):
            self.t.forward(self.tol)
            self.t.left(90)
            self.t.forward(self.arz)
            self.t.left(90)
            
    def run_single_shape(self):
        
        self.t.penup()
        self.t.goto(0, 0) 
        self.t.pendown()
        self.draw_rectangle()
        
