def increase_speed():
     t1.reset()
     speedVal=int(progSpeed['value'])
     if speedVal<200:
          speedVal=speedVal+10
          progSpeed['value']=speedVal

def decrease_speed():
     t1.reset()
     speedVal=int(progSpeed['value'])
     if speedVal>10:
          speedVal=speedVal-10
          progSpeed['value']=speedVal
def increase_size2():
