def zakhire_kardan():
     rnd=random.randint(1000000,9999999)
     eps_file = "temp_drawing.eps"
     png_file = "my_drawing"+str(rnd)+".png"   
     canvas = screen.getcanvas()
     canvas.postscript(file=eps_file)
     img = Image.open(eps_file)
